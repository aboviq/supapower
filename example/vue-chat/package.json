{
  "name": "vue-chat-example",
  "version": "0.0.0",
  "private": true,
  "description": "A browser chat app demoing Supapower with PGlite's multi-tab worker: every tab shares one local database and one of them syncs it with Supabase",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --project tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.116.0",
    "@supapower/vue": "workspace:*",
    "supapower": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  }
}
