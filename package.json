{
  "name": "supapower-monorepo",
  "private": true,
  "description": "Monorepo for Supapower, a sync engine that keeps a local PGlite database in sync with Supabase",
  "license": "Apache-2.0",
  "author": "Aboviq AB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboviq/supapower.git"
  },
  "workspaces": [
    "packages/*",
    "example/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "changeset": "changeset",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test",
    "clean": "bun run --filter '*' clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "release": "bun run build && changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
